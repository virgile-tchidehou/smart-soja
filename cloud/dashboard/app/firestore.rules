rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Règle par défaut : authentification requise
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Sécurisation plus fine des utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Unités IoT
    match /units/{unitId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Lots de production
    match /lots/{lotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Télémétrie historique
    match /telemetry/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
